{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noUncheckedIndexedAccess": true,
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@boloes/domain-core": ["packages/domain-core/src/index.ts"],
      "@boloes/lottery-contracts": ["packages/lottery-contracts/src/index.ts"],
      "@boloes/data-access": ["packages/data-access/src/index.ts"],
      "@boloes/result-ingestion": ["packages/result-ingestion/src/index.ts"],
      "@boloes/strategy-registry": ["packages/strategy-registry/src/index.ts"],
      "@boloes/statistics-engine": ["packages/statistics-engine/src/index.ts"],
      "@boloes/combinatorics": ["packages/combinatorics/src/index.ts"],
      "@boloes/audit-engine": ["packages/audit-engine/src/index.ts"],
      "@boloes/coverage-engine": ["packages/coverage-engine/src/index.ts"],
      "@boloes/lottery-lotofacil": ["packages/lotteries/lotofacil/src/index.ts"]
    }
  }
}
